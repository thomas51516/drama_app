# URL de base de l'API backend (NestJS). Lue à l'exécution (runtime config).
NUXT_PUBLIC_API_BASE=http://localhost:3000
# true : le client API renvoie les fixtures de web/layers/base/mocks/ (aucun appel réseau).
# Par défaut true en `nuxt dev`, false en build de production.
NUXT_PUBLIC_API_MOCK=true
# Base publique des médias (manifestes HLS, vignettes) : bucket MinIO en dev, CDN en production.
NUXT_PUBLIC_CDN_BASE_URL=http://localhost:9000/drama-media
