# ----------------------------------------------------------------------------
# DRAMA — variables de production (S10-OPS, docs/ops/deploiement.md)
# Copier en `infra/.env.prod` (ignoré par git, jamais committé). Reprend les noms de
# `backend/.env.example` : mêmes variables, valeurs de production au lieu des valeurs de dev.
# Les secrets doivent venir d'un coffre (CI secrets, Vault…) au moment du déploiement, jamais
# tapés ni collés dans ce fichier sur un poste partagé — voir docs/ops/deploiement.md §5.
# ----------------------------------------------------------------------------

# --- Déploiement (lu par docker-compose.prod.yml et Traefik, pas par l'API elle-même) ----------
# Domaine public de l'API (enregistrement DNS A/AAAA déjà en place avant le premier déploiement).
API_DOMAIN=api.drama.example
# E-mail transmis à Let's Encrypt (expiration de certificat, pas de notification secrète).
ACME_EMAIL=ops@drama.example
# Image Docker de l'API : nom et étiquette. Avec un registre (ghcr.io, Docker Hub privé…),
# mettre le chemin complet (ex. ghcr.io/votre-org/drama-api) et l'étiquette du tag/commit déployé.
API_IMAGE=drama-api
API_IMAGE_TAG=latest

# --- Application -------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=log
# Origines exactes du back-office et du site de recharge — JAMAIS `*` en production (l'API
# s'authentifie par en-tête Authorization, pas par cookie, mais une origine précise reste la
# bonne pratique : docs/ops/securite.md §6, API8).
CORS_ORIGINS=https://admin.drama.example,https://recharge.drama.example
# Swagger public = surface d'information en plus pour un attaquant ; à désactiver en production
# sauf besoin documenté (intégrateur tiers, etc.).
SWAGGER_ENABLED=false

# --- Données ------------------------------------------------------------------
# Base de données managée (PITR + sauvegardes automatiques activées côté fournisseur — voir
# docs/ops/deploiement.md §3 pour l'alternative auto-hébergée si aucun service managé n'est
# disponible). `sslmode=require` recommandé dès que le fournisseur le permet.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/drama?schema=public&sslmode=require
# Taille du pool de connexions `pg` (S10-OPS-01) : rester sous `max_connections` du fournisseur
# moins la marge pour les autres clients (sauvegarde, admin, migrations, autres réplicas de l'API).
# Avec N réplicas `api`, le total consommé est N × DATABASE_POOL_SIZE : calculer en conséquence.
DATABASE_POOL_SIZE=20
# Redis managé (ou un conteneur Redis dédié si auto-hébergé — jamais partagé avec un autre projet :
# sert à la fois le cache catalogue, la limitation de débit et les files BullMQ).
REDIS_URL=rediss://<user>:<password>@<host>:6379

# --- Authentification ---------------------------------------------------------
# Générer avec : openssl rand -base64 48 — DEUX secrets distincts, jamais réutilisés d'un
# environnement à l'autre (dev ≠ recette ≠ production).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_DAYS=30

# --- Stockage objet (S3 / R2 / Wasabi — JAMAIS MinIO en production) ----------
S3_ENDPOINT=https://<bucket>.s3.<region>.amazonaws.com
S3_REGION=eu-west-3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=drama-media-prod
S3_FORCE_PATH_STYLE=false

# --- Vidéo / CDN ---------------------------------------------------------------
# Base publique du CDN devant le bucket (jamais l'URL S3 brute en trafic réel).
CDN_BASE_URL=https://cdn.drama.example
PLAYBACK_URL_TTL_SECONDS=300
# `hmac` recommandé en production avec un CDN à jeton (Bunny/KeyCDN/CloudFront signé) — `plain`
# ne protège pas les URLs de lecture au-delà de leur caractère non deviné.
MEDIA_SIGNER=hmac
MEDIA_SIGNING_KEY=

# --- Connexion Google, OTP SMS, suppression de compte ------------------------
GOOGLE_CLIENT_IDS=
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
ACCOUNT_DELETION_GRACE_DAYS=30
SCHEDULER_ENABLED=true

# --- Back-office (admin) -------------------------------------------------------
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL_SECONDS=28800
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=DRAMA
TRUSTED_DEVICE_DAYS=30

# --- Notifications push --------------------------------------------------------
PUSH_PROVIDER=fcm
FIREBASE_SERVICE_ACCOUNT_JSON=
PUSH_DAILY_CAP=2
PUSH_QUEUE_ENABLED=true
PUSH_BATCH_SIZE=500

# --- Centre d'aide ---------------------------------------------------------------
SUPPORT_CONTACT_DAILY_LIMIT=5

# --- Achats Google Play et pièces ------------------------------------------------
# `fake` est REFUSÉ au démarrage si NODE_ENV=production (src/config/env.schema.ts) : laisser
# `google`, jamais `fake`, ici.
BILLING_VERIFIER=google
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.drama.app
# OBLIGATOIRE en production depuis l'audit sécurité (docs/ops/securite.md §2) : sans ce jeton,
# `POST /webhooks/google-rtdn` n'a aucun contrôle d'authenticité. L'application refuse de démarrer
# si NODE_ENV=production et cette variable est vide.
GOOGLE_RTDN_AUTH_TOKEN=
BONUS_VALIDITY_DAYS=30

# --- Pub récompensée --------------------------------------------------------------
# `fake` est REFUSÉ en production (même mécanisme que BILLING_VERIFIER).
AD_PROVIDER=admob
ADMOB_REWARDED_UNIT_ID=
ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# --- Recharge mobile money ---------------------------------------------------------
# `fake` est REFUSÉ en production (même mécanisme).
MOBILE_MONEY_PROVIDER=cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
TOPUP_PUBLIC_BASE_URL=https://api.drama.example
TOPUP_RETURN_URL=https://recharge.drama.example/retour

# --- Offre de bienvenue (valeurs initiales, modifiables ensuite dans le back-office) -------
WELCOME_OFFER_ACTIVE=false
WELCOME_OFFER_BONUS_PERCENT=0
WELCOME_OFFER_HOURS=48

# --- Upload direct et transcodage ------------------------------------------------
UPLOAD_URL_TTL_SECONDS=900
# `webhook` recommandé en production (service de transcodage géré, cahier des charges §9/§12) ;
# `local` seulement si le service `worker` (profil optionnel, docker-compose.prod.yml) est utilisé.
TRANSCODE_PROVIDER=webhook
TRANSCODE_WORKER_ENABLED=false
TRANSCODE_CONCURRENCY=1
TRANSCODE_WEBHOOK_SECRET=
TRANSCODE_SUBMIT_URL=

# --- Sécurité et observabilité ------------------------------------------------------
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
# Obligatoire en pratique dès que /metrics pourrait être atteignable depuis l'extérieur du réseau
# interne (voir le commentaire sur le service `api` dans docker-compose.prod.yml).
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# --- Seed (prisma db seed — à ne lancer qu'une fois, manuellement, au tout premier déploiement) --
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
