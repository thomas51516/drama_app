# ----------------------------------------------------------------------------
# DRAMA backend — variables d'environnement
# Copier en `.env` (ignoré par git). Toutes les variables sont validées au
# démarrage par src/config/env.schema.ts ; l'application refuse de démarrer
# si une variable obligatoire manque ou est invalide.
# ----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=3000                            # port HTTP de l'API
LOG_LEVEL=log                        # fatal | error | warn | log | debug | verbose
CORS_ORIGINS=http://localhost:3100,http://localhost:3000   # origines autorisées (back-office 3100), ou * (dev uniquement)
SWAGGER_ENABLED=true                 # expose /docs et /docs-json

# --- Données ----------------------------------------------------------------
# Correspond aux valeurs par défaut de infra/docker-compose.dev.yml
DATABASE_URL=postgresql://drama:drama@localhost:5432/drama?schema=public
REDIS_URL=redis://localhost:6379

# --- Authentification -------------------------------------------------------
# Secret HMAC des JWT d'accès (>= 32 caractères). Générer : openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900           # durée de vie du JWT d'accès (15 min)
# Secret (pepper) utilisé pour hacher les jetons de rafraîchissement en base.
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_REFRESH_TTL_DAYS=30              # durée de vie d'un jeton de rafraîchissement

# --- Stockage objet (S3 / MinIO) --------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=drama-media
S3_FORCE_PATH_STYLE=true             # true pour MinIO, false pour AWS S3 / R2

# --- Vidéo / CDN ------------------------------------------------------------
# Base publique des manifestes HLS (clé `hls_key` relative). En dev : le bucket MinIO.
# Base des URLs média (MinIO en dev). Pour un téléphone sur le même Wi-Fi : http://<IP-du-PC>:9000/drama-media
CDN_BASE_URL=http://localhost:9000/drama-media
PLAYBACK_URL_TTL_SECONDS=300         # validité des URLs de manifeste signées (S04-BE-02)

# --- Back-office (admin) ----------------------------------------------------
# Secret HMAC des JWT admin (distinct du JWT utilisateur, claim aud=admin). openssl rand -base64 48
ADMIN_JWT_SECRET=dev-only-admin-secret-change-me-0123456789abcdef
ADMIN_JWT_TTL_SECONDS=28800          # durée de vie d'une session back-office (8 h)
# Clé de chiffrement au repos des secrets TOTP (AES-256-GCM, clé dérivée par SHA-256). openssl rand -base64 48
TOTP_ENCRYPTION_KEY=dev-only-totp-key-change-me-0123456789abcdef
TOTP_ISSUER=DRAMA back-office        # libellé affiché dans l'application d'authentification

# --- Upload direct et transcodage ------------------------------------------
UPLOAD_URL_TTL_SECONDS=900           # validité des URLs pré-signées PUT (sources, affiches)
TRANSCODE_PROVIDER=local             # local (ffmpeg + BullMQ dans le processus) | webhook (service géré)
TRANSCODE_WORKER_ENABLED=true        # false pour ne pas démarrer le worker BullMQ dans ce processus
TRANSCODE_CONCURRENCY=1              # jobs ffmpeg simultanés (mode local)
# Secret HMAC-SHA256 des webhooks POST /webhooks/transcode/{provider} (obligatoire en mode webhook)
TRANSCODE_WEBHOOK_SECRET=dev-only-transcode-webhook-secret-0123456789
# Mode webhook : URL où notifier le service géré d'une nouvelle source (optionnel, signé avec le même secret)
# TRANSCODE_SUBMIT_URL=https://transcoder.example/jobs
FFMPEG_PATH=ffmpeg                   # binaire ffmpeg (>= 6) requis en mode local
FFPROBE_PATH=ffprobe

# --- Sécurité et observabilité ---------------------------------------------
RATE_LIMIT_ENABLED=true              # limites Redis sur /auth/guest, /auth/refresh, /admin/auth/*
METRICS_ENABLED=true                 # expose GET /metrics (Prometheus)
# Si défini, /metrics exige `Authorization: Bearer <METRICS_TOKEN>` (à renseigner aussi dans infra/.env)
# METRICS_TOKEN=change-me-metrics-token
# Sentry n'est activé que si SENTRY_DSN est renseigné
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=staging         # défaut : NODE_ENV

# --- Seed (prisma db seed) --------------------------------------------------
SEED_ADMIN_EMAIL=admin@drama.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
