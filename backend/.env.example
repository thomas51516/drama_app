# ----------------------------------------------------------------------------
# DRAMA backend — variables d'environnement
# Copier en `.env` (ignoré par git). Toutes les variables sont validées au
# démarrage par src/config/env.schema.ts ; l'application refuse de démarrer
# si une variable obligatoire manque ou est invalide.
# ----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=3000                            # port HTTP de l'API
LOG_LEVEL=log                        # fatal | error | warn | log | debug | verbose
CORS_ORIGINS=http://localhost:3100,http://localhost:3000   # origines autorisées (back-office 3100), ou * (dev uniquement)
SWAGGER_ENABLED=true                 # expose /docs et /docs-json

# --- Données ----------------------------------------------------------------
# Correspond aux valeurs par défaut de infra/docker-compose.dev.yml
DATABASE_URL=postgresql://drama:drama@localhost:5432/drama?schema=public
# Taille du pool de connexions `pg` (S10-OPS-01) ; le défaut de la librairie `pg` est 10, trop bas
# dès une centaine de requêtes simultanées. Rester sous `max_connections` Postgres (défaut 100)
# moins la marge des autres clients (sauvegarde, admin, migrations, autres instances de l'API).
DATABASE_POOL_SIZE=20
REDIS_URL=redis://localhost:6379

# --- Authentification -------------------------------------------------------
# Secret HMAC des JWT d'accès (>= 32 caractères). Générer : openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900           # durée de vie du JWT d'accès (15 min)
# Secret (pepper) utilisé pour hacher les jetons de rafraîchissement en base.
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_REFRESH_TTL_DAYS=30              # durée de vie d'un jeton de rafraîchissement

# --- Stockage objet (S3 / MinIO) --------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=drama-media
S3_FORCE_PATH_STYLE=true             # true pour MinIO, false pour AWS S3 / R2

# --- Vidéo / CDN ------------------------------------------------------------
# Base publique des manifestes HLS (clé `hls_key` relative). En dev : le bucket MinIO.
# Base des URLs média (MinIO en dev). Pour un téléphone sur le même Wi-Fi : http://<IP-du-PC>:9000/drama-media
CDN_BASE_URL=http://localhost:9000/drama-media
PLAYBACK_URL_TTL_SECONDS=300         # validité des URLs de manifeste signées (S04-BE-02)
# Signature des URLs de lecture (manifeste /play, extrait /feed) : plain (dev MinIO, aucun contrôle)
# ou hmac (jeton ?token=<base64url(hmac-sha256(clé, chemin + expires))>&expires=<epoch>, CDN type Bunny/KeyCDN).
# NE PAS passer en hmac avec MinIO : il ne vérifie pas le jeton mais le téléphone doit continuer à lire.
MEDIA_SIGNER=plain
# MEDIA_SIGNING_KEY=change-me-media-signing-key-0123456789   # obligatoire en mode hmac (>= 16 caractères)

# --- Connexion Google, OTP SMS, suppression de compte (S05-BE-01 à 04) ------
# Identifiants OAuth « Web » et « Android » acceptés comme audience de l'ID token, séparés par des virgules.
# Vide = connexion Google désactivée (503 GOOGLE_AUTH_DISABLED).
GOOGLE_CLIENT_IDS=
# Fournisseur SMS pour l'OTP : console (dev : code dans les logs de l'API et dans Redis `otp:<requestId>`)
# ou http (POST JSON { to, text } avec `Authorization: Bearer SMS_HTTP_TOKEN` vers SMS_HTTP_URL).
SMS_PROVIDER=console
# SMS_HTTP_URL=https://sms.example/v1/messages
# SMS_HTTP_TOKEN=change-me
ACCOUNT_DELETION_GRACE_DAYS=30       # délai avant anonymisation d'un compte supprimé (§14)
SCHEDULER_ENABLED=true               # tâches planifiées dans ce processus (publications programmées, anonymisation)

# --- Back-office (admin) ----------------------------------------------------
# Secret HMAC des JWT admin (distinct du JWT utilisateur, claim aud=admin). openssl rand -base64 48
ADMIN_JWT_SECRET=dev-only-admin-secret-change-me-0123456789abcdef
ADMIN_JWT_TTL_SECONDS=28800          # durée de vie d'une session back-office (8 h)
# Clé de chiffrement au repos des secrets TOTP (AES-256-GCM, clé dérivée par SHA-256). openssl rand -base64 48
TOTP_ENCRYPTION_KEY=dev-only-totp-key-change-me-0123456789abcdef
TOTP_ISSUER=DRAMA back-office        # libellé affiché dans l'application d'authentification
TRUSTED_DEVICE_DAYS=30               # durée d'un appareil de confiance (« se souvenir de cet appareil », B-13+)

# --- Notifications push (S06-BE-01, B-10) ----------------------------------
# log (dev : push écrit dans les logs et dans push_deliveries) | fcm (Firebase Admin SDK)
PUSH_PROVIDER=log
# Compte de service Firebase (Paramètres du projet → Comptes de service → Générer une clé privée),
# soit le JSON en une ligne, soit le chemin du fichier. Obligatoire en mode fcm.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_FILE=/etc/drama/firebase-service-account.json
PUSH_DAILY_CAP=2                     # push maximum par utilisateur et par jour, toutes causes confondues (§13)
PUSH_QUEUE_ENABLED=true              # file BullMQ `push` + worker dans ce processus ; false = envoi en ligne (tests)
PUSH_BATCH_SIZE=500                  # utilisateurs par lot d'envoi de campagne

# --- Centre d'aide (S06-BE-02) ---------------------------------------------
SUPPORT_CONTACT_DAILY_LIMIT=5        # demandes de contact par utilisateur et par jour

# --- Achats Google Play et pièces (S07-BE-05 à 07) ---------------------------
# Vérificateur des jetons d'achat : fake (dev et tests : jetons `fake:<productId>:<nonce>`, REFUSÉ en production)
# ou google (Play Developer API avec un compte de service lié à la Play Console).
BILLING_VERIFIER=fake
# Compte de service Google Play (JSON en une ligne ou chemin de fichier) et nom du package Android ; obligatoires en mode google.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/etc/drama/google-play-service-account.json
# GOOGLE_PLAY_PACKAGE_NAME=com.drama.app
# Jeton attendu par POST /webhooks/google-rtdn (`?token=` ou `Authorization: Bearer`) ; vide = aucun contrôle (dev).
# GOOGLE_RTDN_AUTH_TOKEN=change-me-rtdn-token-0123456789
BONUS_VALIDITY_DAYS=30               # validité par défaut des pièces bonus (repris dans les paramètres de monétisation)

# --- Pub récompensée (S08-BE-03) ---------------------------------------------
# Vérificateur du callback SSV : fake (dev et tests : signature HMAC-SHA256 de la requête avec AD_SSV_FAKE_SECRET,
# REFUSÉ en production) ou admob (signature ECDSA vérifiée avec les clés publiques Google, cache 24 h).
AD_PROVIDER=fake
AD_SSV_FAKE_SECRET=dev-only-ad-ssv-fake-secret-0123456789
# Bloc d'annonce récompensée AdMob renvoyé par GET /ads/eligibility (obligatoire pour que l'app affiche une pub en mode admob).
# ADMOB_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# --- Recharge mobile money (S09-BE-01/02) -----------------------------------
# fake (dev : page de paiement simulée GET /topup/fake/{orderId} avec boutons Payer / Échouer, REFUSÉ en production)
# ou cinetpay (initialisation de paiement + webhook vérifié par HMAC-SHA256 avec CINETPAY_SECRET).
MOBILE_MONEY_PROVIDER=fake
MOBILE_MONEY_FAKE_SECRET=dev-only-mobile-money-fake-secret-0123456789
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET=
# CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
# Base publique de l'API, utilisée pour l'URL de notification du webhook et la page de paiement simulée.
TOPUP_PUBLIC_BASE_URL=http://localhost:3000
# Page du site de recharge vers laquelle l'agrégateur renvoie l'utilisateur après paiement (optionnelle).
# TOPUP_RETURN_URL=http://localhost:3200/recharge/retour

# --- Offre de bienvenue (M-24, B-07) : valeurs initiales, modifiables dans le back-office -----
WELCOME_OFFER_ACTIVE=false
WELCOME_OFFER_BONUS_PERCENT=0
WELCOME_OFFER_HOURS=48

# --- Upload direct et transcodage ------------------------------------------
UPLOAD_URL_TTL_SECONDS=900           # validité des URLs pré-signées PUT (sources, affiches)
TRANSCODE_PROVIDER=local             # local (ffmpeg + BullMQ dans le processus) | webhook (service géré)
TRANSCODE_WORKER_ENABLED=true        # false pour ne pas démarrer le worker BullMQ dans ce processus
TRANSCODE_CONCURRENCY=1              # jobs ffmpeg simultanés (mode local)
# Secret HMAC-SHA256 des webhooks POST /webhooks/transcode/{provider} (obligatoire en mode webhook)
TRANSCODE_WEBHOOK_SECRET=dev-only-transcode-webhook-secret-0123456789
# Mode webhook : URL où notifier le service géré d'une nouvelle source (optionnel, signé avec le même secret)
# TRANSCODE_SUBMIT_URL=https://transcoder.example/jobs
FFMPEG_PATH=ffmpeg                   # binaire ffmpeg (>= 6) requis en mode local
FFPROBE_PATH=ffprobe

# --- Sécurité et observabilité ---------------------------------------------
RATE_LIMIT_ENABLED=true              # limites Redis sur /auth/guest, /auth/refresh, /admin/auth/*
METRICS_ENABLED=true                 # expose GET /metrics (Prometheus)
# Si défini, /metrics exige `Authorization: Bearer <METRICS_TOKEN>` (à renseigner aussi dans infra/.env)
# METRICS_TOKEN=change-me-metrics-token
# Sentry n'est activé que si SENTRY_DSN est renseigné
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=staging         # défaut : NODE_ENV

# --- Seed (prisma db seed) --------------------------------------------------
SEED_ADMIN_EMAIL=admin@drama.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
