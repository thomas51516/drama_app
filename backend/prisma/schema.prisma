// =============================================================================
// DRAMA — schéma de données (cahier des charges §8.3, ticket S01-BE-02)
//
// RÈGLE DU GRAND LIVRE (source de vérité des pièces) :
//   * Toute variation de pièces est une ligne APPEND-ONLY de `coin_ledger`
//     (montant signé, type, référence, clé d'idempotence unique).
//   * `wallets.purchased_balance` / `wallets.bonus_balance` ne sont que des
//     PROJECTIONS : elles sont mises à jour dans la même transaction SQL que
//     l'insertion de la ligne de grand livre et doivent toujours être égales à
//     SUM(amount) des lignes du bucket correspondant. Elles sont recalculables.
//   * Jamais d'UPDATE direct d'un solde sans ligne de grand livre ; jamais de
//     DELETE ou d'UPDATE sur `coin_ledger` (une correction = une ligne
//     ADJUSTMENT ou REFUND).
//   * Les pièces bonus (bucket BONUS) portent `expires_at` et sont consommées
//     avant les pièces achetées ; leur expiration est elle-même une ligne EXPIRY.
//
// Conventions : identifiants UUID v7 (triables), tables et colonnes en
// snake_case via @@map/@map, horodatages en UTC (`timestamptz`).
// =============================================================================

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserType {
  GUEST
  REGISTERED

  @@map("user_type")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETION_PENDING
  /// Compte invité fusionné dans un compte inscrit (M-50) ; conservé pour l'historique comptable.
  MERGED
  DELETED

  @@map("user_status")
}

/// Fournisseur d'identité d'un utilisateur final (M-51).
enum IdentityProvider {
  GOOGLE
  PHONE
  EMAIL

  @@map("identity_provider")
}

enum SeriesStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("series_status")
}

/// Classification d'âge (B-01).
enum AgeRating {
  ALL
  PG12
  PG16
  R18

  @@map("age_rating")
}

enum TranscodeStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED

  @@map("transcode_status")
}

/// Bucket de pièces affecté par une ligne de grand livre.
enum CoinBucket {
  PURCHASED
  BONUS

  @@map("coin_bucket")
}

enum LedgerEntryType {
  PURCHASE
  BONUS
  UNLOCK
  ADJUSTMENT
  EXPIRY
  REFUND
  /// Transfert de solde lors de la fusion d'un compte invité (M-50, contrat v1.4).
  MERGE

  @@map("ledger_entry_type")
}

enum UnlockMethod {
  COINS
  AD
  VIP
  FREE

  @@map("unlock_method")
}

enum PaymentProvider {
  GOOGLE_PLAY
  MOBILE_MONEY

  @@map("payment_provider")
}

enum PurchaseStatus {
  PENDING
  VERIFIED
  CREDITED
  ACKNOWLEDGED
  REFUNDED
  FAILED

  @@map("purchase_status")
}

enum SubscriptionPlan {
  WEEKLY
  MONTHLY
  YEARLY

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  ACTIVE
  IN_GRACE
  ON_HOLD
  PAUSED
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

/// Période d'une formule VIP exposée à l'application (contrat v1.4 `VipPlan.period`).
enum VipPeriod {
  WEEK
  MONTH
  YEAR

  @@map("vip_period")
}

/// Rôles du back-office (B-13).
enum AdminRole {
  EDITOR
  MONETIZATION
  SUPPORT
  ADMIN

  @@map("admin_role")
}

enum TokenSubjectType {
  USER
  ADMIN

  @@map("token_subject_type")
}

/// Type de rangée de l'accueil (B-05, S04-BE-01).
enum HomeRowType {
  MANUAL
  TRENDING
  NEW
  GENRE
  CONTINUE_WATCHING

  @@map("home_row_type")
}

/// Résultat d'une remise de push au fournisseur (S06-BE-01).
enum PushDeliveryStatus {
  SENT
  FAILED
  /// Non envoyé : plafond quotidien atteint, aucun appareil ou préférence désactivée.
  SKIPPED

  @@map("push_delivery_status")
}

/// Cible d'une campagne push (B-10).
enum CampaignSegmentType {
  ALL
  COUNTRY
  SERIES_FOLLOWERS
  INACTIVE

  @@map("campaign_segment_type")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED

  @@map("campaign_status")
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  CLOSED

  @@map("support_ticket_status")
}

enum SupportMessageAuthor {
  USER
  SUPPORT

  @@map("support_message_author")
}

/// Périodicité d'une tâche récompensée (M-41) : par jour, par semaine ou une seule fois.
enum RewardTaskPeriod {
  DAY
  WEEK
  ONCE

  @@map("reward_task_period")
}

/// Session de pub récompensée (M-22) : créée par l'app, résolue par le callback SSV de la régie.
enum AdSessionStatus {
  PENDING
  REWARDED
  EXPIRED
  REJECTED

  @@map("ad_session_status")
}

/// Commande de recharge mobile money (M-34, S09-BE-01).
enum TopupOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED

  @@map("topup_order_status")
}

// -----------------------------------------------------------------------------
// Utilisateurs finaux
// -----------------------------------------------------------------------------

model User {
  id                      String     @id @default(uuid(7)) @db.Uuid
  type                    UserType   @default(GUEST)
  status                  UserStatus @default(ACTIVE)
  phone                   String?    @unique @db.VarChar(32)
  email                   String?    @unique @db.VarChar(320)
  /// Hachage Argon2id du mot de passe (connexion e-mail, S05-BE-03).
  passwordHash            String?    @map("password_hash")
  displayName             String?    @map("display_name") @db.VarChar(80)
  /// ISO 3166-1 alpha-2 (ex. TG, CI, SN, FR).
  country                 String?    @db.Char(2)
  /// BCP 47 court (fr, en, es, pt).
  language                String     @default("fr") @db.VarChar(8)
  /// Identifiant d'installation fourni par l'app pour le compte invité (M-50).
  deviceId                String?    @map("device_id") @db.VarChar(128)
  isVip                   Boolean    @default(false) @map("is_vip")
  vipExpiresAt            DateTime?  @map("vip_expires_at") @db.Timestamptz(3)
  /// Déblocage automatique de l'épisode suivant si le solde le permet (§3).
  autoUnlock              Boolean    @default(false) @map("auto_unlock")
  /// Préférences de notification `{ newEpisodes, offers, checkinReminder }` (M-52, M-54).
  notificationPreferences Json?      @map("notification_preferences")
  /// Date d'anonymisation prévue (statut DELETION_PENDING, délai de 30 jours — §14).
  deletionScheduledAt     DateTime?  @map("deletion_scheduled_at") @db.Timestamptz(3)
  /// Compte inscrit dans lequel cet invité a été fusionné (statut MERGED).
  mergedIntoId            String?    @map("merged_into_id") @db.Uuid
  lastSeenAt              DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  wallet           Wallet?
  ledgerEntries    CoinLedgerEntry[]
  unlocks          Unlock[]
  purchases        Purchase[]
  subscriptions    Subscription[]
  watchProgress    WatchProgress[]
  favorites        Favorite[]
  likes            Like[]
  identities       UserIdentity[]
  refreshTokens    RefreshToken[]
  pushDevices      PushDevice[]
  notifications    Notification[]
  supportTickets   SupportTicket[]
  checkinClaims    CheckinClaim[]
  rewardTaskClaims RewardTaskClaim[]
  adSessions       AdSession[]
  promoRedemptions PromoRedemption[]
  topupOrders      TopupOrder[]

  @@index([deviceId])
  @@index([createdAt])
  @@index([isVip, vipExpiresAt])
  @@index([status, deletionScheduledAt])
  @@map("users")
}

/// Identités externes rattachées à un compte (Google `sub`, téléphone E.164, e-mail normalisé).
model UserIdentity {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  provider  IdentityProvider
  /// Identifiant chez le fournisseur : `sub` Google, numéro E.164, e-mail en minuscules.
  subject   String           @db.VarChar(320)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

// -----------------------------------------------------------------------------
// Catalogue
// -----------------------------------------------------------------------------

model Series {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  slug                String                   @unique @db.VarChar(160)
  title               String                   @db.VarChar(200)
  synopsis            String
  /// Genres libres au MVP (ex. "romance", "thriller") ; table dédiée si besoin.
  genres              String[]                 @default([])
  tags                String[]                 @default([])
  originalLanguage    String                   @default("fr") @map("original_language") @db.VarChar(8)
  posterVerticalUrl   String?                  @map("poster_vertical_url")
  posterHorizontalUrl String?                  @map("poster_horizontal_url")
  /// Nombre d'épisodes gratuits en tête de série (§3, B-06).
  freeEpisodeCount    Int                      @default(5) @map("free_episode_count")
  /// Coût en pièces d'un épisode payant (B-06).
  coinCostPerEpisode  Int                      @default(10) @map("coin_cost_per_episode")
  /// Déblocage par pub récompensée autorisé sur cette série (M-22, contrat v1.5).
  adUnlockEnabled     Boolean                  @default(true) @map("ad_unlock_enabled")
  status              SeriesStatus             @default(DRAFT)
  /// Territoires autorisés (ISO 3166-1 alpha-2). Vide = monde entier (B-12).
  territories         String[]                 @default([])
  ageRating           AgeRating                @default(ALL) @map("age_rating")
  /// Projection du nombre de « J'aime » (table `likes`), mise à jour dans la même transaction.
  likesCount          Int                      @default(0) @map("likes_count")
  /// Vecteur de recherche plein texte (titre, synopsis, tags ; dictionnaires french + simple, unaccent),
  /// maintenu par le trigger `series_search_vector_refresh` (S05-BE-06).
  searchVector        Unsupported("tsvector")? @map("search_vector")
  /// Date de publication ; peut être future (publication programmée, B-04) : la série reste
  /// invisible du public tant qu'elle n'est pas atteinte.
  publishedAt         DateTime?                @map("published_at") @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  episodes       Episode[]
  favorites      Favorite[]
  likes          Like[]
  homeBanners    HomeBanner[]
  /// Contrat de droits courant (B-12). Au plus un par série ; voir `rights_contracts`.
  rightsContract RightsContract?

  @@index([status, publishedAt(sort: Desc)])
  @@index([genres], type: Gin)
  @@index([searchVector], type: Gin)
  @@map("series")
}

model Episode {
  id                  String          @id @default(uuid(7)) @db.Uuid
  seriesId            String          @map("series_id") @db.Uuid
  number              Int
  title               String?         @db.VarChar(200)
  durationSeconds     Int             @default(0) @map("duration_seconds")
  transcodeStatus     TranscodeStatus @default(PENDING) @map("transcode_status")
  /// Clé du fichier maître dans le stockage objet (upload back-office, §9).
  sourceKey           String?         @map("source_key")
  /// Clé (ou URL absolue en dev) du manifeste HLS maître.
  hlsKey              String?         @map("hls_key")
  thumbnailUrl        String?         @map("thumbnail_url")
  /// Extrait de 15 s pour le flux vertical (M-02).
  previewKey          String?         @map("preview_key")
  /// Dernière erreur de transcodage (statut FAILED), effacée à la relance.
  transcodeError      String?         @map("transcode_error")
  /// Identifiant du job chez le fournisseur de transcodage géré (webhook), ou job BullMQ en local.
  transcodeExternalId String?         @map("transcode_external_id") @db.VarChar(200)
  publishedAt         DateTime?       @map("published_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  series        Series          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  subtitles     Subtitle[]
  unlocks       Unlock[]
  watchProgress WatchProgress[]
  adSessions    AdSession[]

  @@unique([seriesId, number])
  @@index([publishedAt(sort: Desc)])
  @@index([transcodeStatus])
  @@index([transcodeExternalId])
  @@map("episodes")
}

model Subtitle {
  id        String   @id @default(uuid(7)) @db.Uuid
  episodeId String   @map("episode_id") @db.Uuid
  language  String   @db.VarChar(8)
  fileUrl   String   @map("file_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, language])
  @@map("subtitles")
}

/// Droits et contrats (B-12, S09-BE). Décision : un contrat « courant » par série (1-1, pas
/// d'historique) ; l'édition remplace les champs en place plutôt que de créer une nouvelle ligne.
/// `rightsStatus` (NONE | ACTIVE | EXPIRED) est calculé à la lecture, jamais stocké :
/// NONE = pas de ligne, ACTIVE = `licenseStartsAt <= now <= licenseEndsAt` (ou pas de fin),
/// EXPIRED = ligne présente mais hors fenêtre (licence terminée OU pas encore commencée ; l'énumération
/// à trois états du cahier des charges n'a pas de valeur dédiée pour une licence pas encore démarrée).
model RightsContract {
  id              String    @id @default(uuid(7)) @db.Uuid
  seriesId        String    @unique @map("series_id") @db.Uuid
  /// Ayant droit (personne ou société titulaire des droits).
  rightsHolder    String    @map("rights_holder") @db.VarChar(200)
  /// Territoires couverts (ISO 3166-1 alpha-2, mêmes codes que `series.territories`). Vide = monde entier.
  territories     String[]  @default([])
  licenseStartsAt DateTime  @map("license_starts_at") @db.Timestamptz(3)
  /// `null` = licence à durée indéterminée.
  licenseEndsAt   DateTime? @map("license_ends_at") @db.Timestamptz(3)
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([licenseEndsAt])
  @@map("rights_contracts")
}

// -----------------------------------------------------------------------------
// Mise en avant : configuration de l'accueil (B-05, S04-BE-01)
// -----------------------------------------------------------------------------

/// Bannière de l'accueil (M-01). `countries` vide = partout ; fenêtre d'affichage optionnelle.
model HomeBanner {
  id        String    @id @default(uuid(7)) @db.Uuid
  seriesId  String    @map("series_id") @db.Uuid
  /// Visuel 16:9 ; `null` = affiche horizontale de la série.
  imageUrl  String?   @map("image_url")
  title     String?   @db.VarChar(200)
  subtitle  String?   @db.VarChar(300)
  /// ISO 3166-1 alpha-2 ; vide = tous les pays.
  countries String[]  @default([])
  position  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([isActive, position])
  @@map("home_banners")
}

/// Rangée de l'accueil : titres par langue (`{ fr, en, es, pt }`), filtre pays, ordre.
model HomeRow {
  id        String      @id @default(uuid(7)) @db.Uuid
  /// Clé stable exposée à l'application (ex. `trending`, `genre-romance`).
  key       String      @unique @db.VarChar(80)
  type      HomeRowType
  /// Titres localisés `{ "fr": "Tendances", "en": "Trending", ... }` ; `fr` obligatoire.
  titles    Json
  /// Genre ciblé (type GENRE).
  genre     String?     @db.VarChar(40)
  /// Liste ordonnée de séries (type MANUAL).
  seriesIds String[]    @default([]) @map("series_ids") @db.Uuid
  countries String[]    @default([])
  position  Int         @default(0)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, position])
  @@map("home_rows")
}

// -----------------------------------------------------------------------------
// Pièces : portefeuille (projection) et grand livre (source de vérité)
// -----------------------------------------------------------------------------

/// Projection des soldes ; voir la règle du grand livre en tête de fichier.
model Wallet {
  userId           String   @id @map("user_id") @db.Uuid
  purchasedBalance Int      @default(0) @map("purchased_balance")
  bonusBalance     Int      @default(0) @map("bonus_balance")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// Append-only. Une ligne = une variation de solde.
model CoinLedgerEntry {
  id             String          @id @default(uuid(7)) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  /// Montant signé en pièces (+ crédit, - débit).
  amount         Int
  bucket         CoinBucket
  type           LedgerEntryType
  /// Type de l'objet référencé (purchase, unlock, reward, admin_adjustment...).
  referenceType  String?         @map("reference_type") @db.VarChar(40)
  referenceId    String?         @map("reference_id") @db.VarChar(128)
  /// Clé d'idempotence fournie par l'appelant ou dérivée (§8.4).
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(200)
  /// Date d'expiration des pièces bonus créditées par cette ligne.
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz(3)
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  unlock Unlock?

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, expiresAt])
  @@index([referenceType, referenceId])
  @@map("coin_ledger")
}

model Unlock {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  episodeId      String       @map("episode_id") @db.Uuid
  method         UnlockMethod
  /// Ligne de débit associée (méthode COINS) — même transaction SQL.
  ledgerEntryId  String?      @unique @map("ledger_entry_id") @db.Uuid
  /// Clé d'idempotence fournie par l'application (`POST /episodes/{id}/unlock`, S07-BE-02).
  idempotencyKey String?      @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode     Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  ledgerEntry CoinLedgerEntry? @relation(fields: [ledgerEntryId], references: [id])

  @@unique([userId, episodeId])
  @@index([episodeId])
  @@map("unlocks")
}

// -----------------------------------------------------------------------------
// Paiements et abonnements
// -----------------------------------------------------------------------------

model Purchase {
  id            String          @id @default(uuid(7)) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  provider      PaymentProvider
  /// SKU Google Play ou identifiant de pack mobile money.
  productId     String          @map("product_id") @db.VarChar(120)
  /// Jeton d'achat Google ou identifiant de transaction agrégateur — unique (idempotence).
  purchaseToken String          @unique @map("purchase_token") @db.VarChar(512)
  orderId       String?         @map("order_id") @db.VarChar(120)
  /// Montant en unité mineure de la devise (centimes ; FCFA sans décimale).
  amountMinor   Int?            @map("amount_minor")
  currency      String?         @db.Char(3)
  /// Pièces à créditer (achetées + bonus de pack).
  coins         Int             @default(0)
  bonusCoins    Int             @default(0) @map("bonus_coins")
  status        PurchaseStatus  @default(PENDING)
  rawPayload    Json?           @map("raw_payload")
  verifiedAt    DateTime?       @map("verified_at") @db.Timestamptz(3)
  creditedAt    DateTime?       @map("credited_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("purchases")
}

model Subscription {
  id                  String             @id @default(uuid(7)) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  plan                SubscriptionPlan
  provider            PaymentProvider    @default(GOOGLE_PLAY)
  productId           String             @map("product_id") @db.VarChar(120)
  purchaseToken       String?            @unique @map("purchase_token") @db.VarChar(512)
  startsAt            DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime           @map("ends_at") @db.Timestamptz(3)
  autoRenew           Boolean            @default(true) @map("auto_renew")
  status              SubscriptionStatus @default(ACTIVE)
  /// Jeton remplacé lors d'un changement de formule (`linkedPurchaseToken`).
  linkedPurchaseToken String?            @map("linked_purchase_token") @db.VarChar(512)
  /// Dernier état brut renvoyé par le magasin (diagnostic).
  rawPayload          Json?              @map("raw_payload")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([endsAt])
  @@map("subscriptions")
}

// -----------------------------------------------------------------------------
// Monétisation : paramètres, packs de pièces, formules VIP (B-06, B-08, S07-BE-05)
// -----------------------------------------------------------------------------

/// Paramètres de monétisation (une seule ligne, id `default`) ; les séries gardent leurs propres
/// valeurs `free_episode_count` / `coin_cost_per_episode`, ces défauts s'appliquent à la création.
model MonetizationSettings {
  id                          String   @id @default("default") @db.VarChar(16)
  defaultFreeEpisodes         Int      @default(5) @map("default_free_episodes")
  defaultCoinCost             Int      @default(10) @map("default_coin_cost")
  seriesUnlockDiscountPercent Int      @default(0) @map("series_unlock_discount_percent")
  adDailyCap                  Int      @default(3) @map("ad_daily_cap")
  autoUnlockDefault           Boolean  @default(false) @map("auto_unlock_default")
  /// Durée de validité des pièces bonus créditées (jours).
  bonusValidityDays           Int      @default(30) @map("bonus_validity_days")
  /// Barème du check-in quotidien sur 7 jours (M-40, B-08).
  checkinDays                 Int[]    @default([5, 5, 10, 10, 15, 20, 30]) @map("checkin_days")
  checkinResetOnMiss          Boolean  @default(true) @map("checkin_reset_on_miss")
  /// Offre de bienvenue (M-24, B-07) : bonus en % sur le premier achat, pendant `hours` après la création du compte.
  welcomeOfferActive          Boolean  @default(false) @map("welcome_offer_active")
  welcomeOfferPackSku         String?  @map("welcome_offer_pack_sku") @db.VarChar(120)
  welcomeOfferBonusPercent    Int      @default(0) @map("welcome_offer_bonus_percent")
  welcomeOfferHours           Int      @default(48) @map("welcome_offer_hours")
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("monetization_settings")
}

/// Pack de pièces (M-30, B-06). `sku` = identifiant produit Play Console, immuable.
/// `prices` : `[{ currency: XOF|NGN|GHS|EUR|USD, amountMinor }]`.
model CoinPack {
  id         String   @id @default(uuid(7)) @db.Uuid
  sku        String   @unique @db.VarChar(120)
  coins      Int
  bonusCoins Int      @default(0) @map("bonus_coins")
  prices     Json
  badge      String?  @db.VarChar(40)
  position   Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, position])
  @@map("coin_packs")
}

/// Formule VIP (M-33, B-06). `sku` = identifiant d'abonnement Play Console.
model VipPlan {
  id        String    @id @default(uuid(7)) @db.Uuid
  sku       String    @unique @db.VarChar(120)
  period    VipPeriod
  prices    Json
  trialDays Int       @default(0) @map("trial_days")
  badge     String?   @db.VarChar(40)
  position  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, position])
  @@map("vip_plans")
}

// -----------------------------------------------------------------------------
// Lecture et préférences
// -----------------------------------------------------------------------------

model WatchProgress {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  episodeId       String   @map("episode_id") @db.Uuid
  positionSeconds Int      @default(0) @map("position_seconds")
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("watch_progress")
}

/// « Ma liste » (M-16).
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  seriesId  String   @map("series_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
  @@map("favorites")
}

/// « J'aime » sur une série (M-16) ; `series.likes_count` en est la projection.
model Like {
  userId    String   @map("user_id") @db.Uuid
  seriesId  String   @map("series_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
  @@index([seriesId])
  @@map("likes")
}

// -----------------------------------------------------------------------------
// Back-office, sessions et audit
// -----------------------------------------------------------------------------

model AdminAccount {
  id            String    @id @default(uuid(7)) @db.Uuid
  email         String    @unique @db.VarChar(320)
  /// Hachage Argon2id (§12).
  passwordHash  String    @map("password_hash")
  displayName   String    @map("display_name") @db.VarChar(80)
  role          AdminRole @default(EDITOR)
  isActive      Boolean   @default(true) @map("is_active")
  /// Secret TOTP chiffré (AES-256-GCM, clé TOTP_ENCRYPTION_KEY) pour la 2FA du back-office (§12).
  totpSecret    String?   @map("totp_secret")
  /// Date de validation du premier code TOTP ; null = enrôlement 2FA à faire à la prochaine connexion.
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  trustedDevices AdminTrustedDevice[]
  campaigns      Campaign[]

  @@map("admin_accounts")
}

/// Jetons de rafraîchissement opaques, stockés hachés (SHA-256 + pepper), à rotation.
model RefreshToken {
  id           String           @id @default(uuid(7)) @db.Uuid
  tokenHash    String           @unique @map("token_hash") @db.Char(64)
  subjectType  TokenSubjectType @map("subject_type")
  userId       String?          @map("user_id") @db.Uuid
  adminId      String?          @map("admin_id") @db.Uuid
  /// Famille de rotation : la réutilisation d'un jeton révoqué invalide toute la famille.
  family       String           @db.Uuid
  deviceId     String?          @map("device_id") @db.VarChar(128)
  userAgent    String?          @map("user_agent") @db.VarChar(512)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(3)
  replacedById String?          @map("replaced_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin AdminAccount? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Compte interne auteur de l'action (null pour une action système).
  actorId    String?  @map("actor_id") @db.Uuid
  actorLabel String?  @map("actor_label") @db.VarChar(120)
  action     String   @db.VarChar(80)
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String?  @map("target_id") @db.VarChar(128)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor AdminAccount? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Appareil de confiance du back-office (B-13+, contrat v1.3) : jeton aléatoire 256 bits remis au
/// navigateur, stocké haché ; permet de sauter le TOTP pendant 30 jours. Révocable.
model AdminTrustedDevice {
  id         String    @id @default(uuid(7)) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  /// Libellé dérivé du User-Agent (navigateur, système).
  label      String    @db.VarChar(200)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  admin AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_trusted_devices")
}

// -----------------------------------------------------------------------------
// Notifications push et campagnes (M-54, S06-BE-01, B-10)
// -----------------------------------------------------------------------------

/// Jeton FCM d'un appareil, lié à l'utilisateur courant (dernier connecté sur l'appareil).
model PushDevice {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique @db.VarChar(512)
  platform   String   @db.VarChar(16)
  locale     String?  @db.VarChar(16)
  appVersion String?  @map("app_version") @db.VarChar(40)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

/// Historique in-app des notifications d'un utilisateur (`GET /me/notifications`).
model Notification {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// `new_episode`, `support_reply`, `campaign`, `offer`, `checkin_reminder`.
  type       String    @db.VarChar(40)
  title      String    @db.VarChar(200)
  body       String    @db.VarChar(1000)
  /// Charge utile de routage (`{ seriesId, episodeId }`, `{ ticketId }`, `{ deepLink }`).
  data       Json?
  campaignId String?   @map("campaign_id") @db.Uuid
  sentAt     DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deliveries PushDelivery[]

  @@index([userId, sentAt(sort: Desc)])
  @@index([campaignId])
  @@map("notifications")
}

/// Résultat renvoyé par le fournisseur de push pour un appareil (journal technique).
model PushDelivery {
  id                String             @id @default(uuid(7)) @db.Uuid
  notificationId    String?            @map("notification_id") @db.Uuid
  userId            String?            @map("user_id") @db.Uuid
  campaignId        String?            @map("campaign_id") @db.Uuid
  /// Jeton d'appareil visé (tronqué à 512).
  token             String?            @db.VarChar(512)
  provider          String             @db.VarChar(16)
  status            PushDeliveryStatus
  providerMessageId String?            @map("provider_message_id") @db.VarChar(200)
  error             String?            @db.VarChar(500)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("push_deliveries")
}

/// Campagne push ciblée (B-10) : segment, envoi immédiat ou programmé, compteurs.
model Campaign {
  id             String              @id @default(uuid(7)) @db.Uuid
  title          String              @db.VarChar(200)
  body           String              @db.VarChar(1000)
  deepLink       String?             @map("deep_link") @db.VarChar(500)
  segmentType    CampaignSegmentType @map("segment_type")
  /// Segment COUNTRY : pays ISO 3166-1 alpha-2.
  countries      String[]            @default([])
  /// Segment SERIES_FOLLOWERS : série dont les favoris sont ciblés.
  seriesId       String?             @map("series_id") @db.Uuid
  /// Segment INACTIVE : sans activité depuis N jours.
  inactiveDays   Int?                @map("inactive_days")
  scheduledAt    DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  status         CampaignStatus      @default(DRAFT)
  audienceCount  Int                 @default(0) @map("audience_count")
  sentCount      Int                 @default(0) @map("sent_count")
  createdById    String?             @map("created_by_id") @db.Uuid
  createdByLabel String?             @map("created_by_label") @db.VarChar(120)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     AdminAccount?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([status, scheduledAt])
  @@index([createdAt(sort: Desc)])
  @@map("campaigns")
}

// -----------------------------------------------------------------------------
// Centre d'aide et support (M-53, S06-BE-02)
// -----------------------------------------------------------------------------

/// Entrée de FAQ ; `question` et `answer` sont des JSON `{ fr, en?, es?, pt? }` (repli fr).
model FaqEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  category    String   @db.VarChar(40)
  question    Json
  answer      Json
  position    Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isPublished, position])
  @@map("faq_entries")
}

model SupportTicket {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  category  String              @db.VarChar(40)
  subject   String              @db.VarChar(200)
  /// Adresse de réponse facultative saisie dans le formulaire.
  email     String?             @db.VarChar(320)
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportMessage {
  id        String               @id @default(uuid(7)) @db.Uuid
  ticketId  String               @map("ticket_id") @db.Uuid
  author    SupportMessageAuthor
  /// Compte interne auteur d'une réponse du support.
  adminId   String?              @map("admin_id") @db.Uuid
  body      String
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// -----------------------------------------------------------------------------
// Récompenses : check-in quotidien et tâches (M-40, M-41, S08-BE-04, B-08)
// -----------------------------------------------------------------------------

/// Un check-in par utilisateur et par jour civil (fuseau du pays) ; `day` = YYYY-MM-DD.
model CheckinClaim {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  day            String   @db.Char(10)
  streakDay      Int      @map("streak_day")
  coins          Int
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("checkin_claims")
}

/// Catalogue des tâches (clés fixes du MVP), paramétrable en back-office (B-08).
model RewardTask {
  key       String           @id @db.VarChar(40)
  coins     Int
  target    Int
  period    RewardTaskPeriod
  position  Int              @default(0)
  isActive  Boolean          @default(true) @map("is_active")
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  claims RewardTaskClaim[]

  @@map("reward_tasks")
}

/// Récompense d'une tâche réclamée ; `periodKey` = jour, semaine ISO ou `once`.
model RewardTaskClaim {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  taskKey        String   @map("task_key") @db.VarChar(40)
  periodKey      String   @map("period_key") @db.VarChar(16)
  coins          Int
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task RewardTask @relation(fields: [taskKey], references: [key], onDelete: Cascade)

  @@unique([userId, taskKey, periodKey])
  @@map("reward_task_claims")
}

// -----------------------------------------------------------------------------
// Pub récompensée (M-22, S08-BE-03)
// -----------------------------------------------------------------------------

model AdSession {
  id            String          @id @default(uuid(7)) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  episodeId     String          @map("episode_id") @db.Uuid
  nonce         String          @db.VarChar(64)
  status        AdSessionStatus @default(PENDING)
  transactionId String?         @unique @map("transaction_id") @db.VarChar(200)
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(3)
  rewardedAt    DateTime?       @map("rewarded_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId, status, rewardedAt])
  @@map("ad_sessions")
}

// -----------------------------------------------------------------------------
// Offres : codes promo et offres limitées (M-24, B-07)
// -----------------------------------------------------------------------------

model PromoCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  code        String    @unique @db.VarChar(40)
  coins       Int
  maxUses     Int?      @map("max_uses")
  perUserUses Int       @default(1) @map("per_user_uses")
  usesCount   Int       @default(0) @map("uses_count")
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id             String   @id @default(uuid(7)) @db.Uuid
  promoCodeId    String   @map("promo_code_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  coins          Int
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([promoCodeId, userId])
  @@map("promo_redemptions")
}

model LimitedOffer {
  id           String   @id @default(uuid(7)) @db.Uuid
  title        String   @db.VarChar(120)
  packSku      String   @map("pack_sku") @db.VarChar(120)
  bonusPercent Int      @map("bonus_percent")
  startsAt     DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, startsAt, endsAt])
  @@map("limited_offers")
}

// -----------------------------------------------------------------------------
// Recharge mobile money (M-34, S09-BE-01/02)
// -----------------------------------------------------------------------------

model TopupOrder {
  id                String           @id @default(uuid(7)) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  packSku           String           @map("pack_sku") @db.VarChar(120)
  coins             Int
  bonusCoins        Int              @default(0) @map("bonus_coins")
  currency          String           @db.Char(3)
  amountMinor       Int              @map("amount_minor")
  country           String           @db.Char(2)
  phone             String?          @db.VarChar(32)
  provider          String           @db.VarChar(16)
  providerReference String?          @unique @map("provider_reference") @db.VarChar(200)
  status            TopupOrderStatus @default(PENDING)
  idempotencyKey    String           @map("idempotency_key") @db.VarChar(128)
  paymentUrl        String?          @map("payment_url")
  purchaseId        String?          @map("purchase_id") @db.Uuid
  rawPayload        Json?            @map("raw_payload")
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz(3)
  paidAt            DateTime?        @map("paid_at") @db.Timestamptz(3)
  creditedAt        DateTime?        @map("credited_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([status, expiresAt])
  @@index([status, paidAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("topup_orders")
}

// -----------------------------------------------------------------------------
// Événements d'analyse côté serveur (§13, S06-BE-03)
// -----------------------------------------------------------------------------

/// Événement du plan de marquage reçu par `POST /events`. Sans clé étrangère : la table est en
/// écriture seule et survit à l'anonymisation des comptes.
model AnalyticsEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  sessionId  String?  @map("session_id") @db.VarChar(64)
  name       String   @db.VarChar(40)
  params     Json
  country    String?  @db.Char(2)
  appVersion String?  @map("app_version") @db.VarChar(40)
  /// Horodatage côté appareil.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([name, occurredAt])
  @@index([userId, occurredAt])
  @@map("analytics_events")
}
